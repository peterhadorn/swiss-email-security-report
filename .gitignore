# Private scan inputs and results. Aggregate release artifacts may be tracked
# only under data/releases/ after the publication validation gate; never add
# raw inputs or domain-level outputs there.
data/*
!data/releases/
!data/releases/**
*.db
*.db-*
*.db.manifest.json
*.sqlite*
*.log
zone-inputs/
zones/
*.zone
domain-lists/
domain-list*/
domains*/
samples/
*-domains.*
*domain-results.*
*scan-results.*

# Local configuration and generated state
.secrets/
.env
.env.*
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/
