{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/peterhadorn/swiss-email-security-report/main/release/schema/citation-cff.schema.json",
  "title": "Strict CFF 1.2 citation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["cff-version", "message", "title", "version", "doi", "authors", "repository-code", "url", "license"],
  "properties": {
    "cff-version": {"const": "1.2.0"},
    "message": {"type": "string", "minLength": 20},
    "title": {"type": "string", "minLength": 20},
    "version": {"const": "v2026.08.2"},
    "doi": {"type": "string", "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$"},
    "authors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/author"}},
    "repository-code": {"const": "https://github.com/peterhadorn/swiss-email-security-report"},
    "url": {"type": "string", "pattern": "^https://doi\\.org/10\\.5281/zenodo\\.[1-9][0-9]*$"},
    "license": {"const": "CC-BY-4.0"}
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family-names", "given-names"],
      "properties": {
        "family-names": {"type": "string", "minLength": 2},
        "given-names": {"type": "string", "minLength": 2}
      }
    }
  }
}
